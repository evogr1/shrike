[Unit]
Description=Shrike crash alert for %i

[Service]
Type=oneshot
ExecStart=/opt/shrike/venv/bin/shrike alert --unit %i
User=shrike
Group=shrike
EnvironmentFile=/etc/shrike/env
Environment=SHRIKE_ENV_FILE=/etc/shrike/env
Environment=SHRIKE_CONFIG=/etc/shrike/config.toml
StateDirectory=shrike
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
TimeoutStartSec=10min
