[Unit]
Description=Search Kestrel backfill of all available Search Console history
After=network-online.target
Wants=network-online.target
OnFailure=sk-alert@%n.service

[Service]
Type=oneshot
ExecStart=/opt/search-kestrel/venv/bin/sk-jobs backfill
User=sk
Group=sk
EnvironmentFile=/etc/search-kestrel/env
Environment=SK_ENV_FILE=/etc/search-kestrel/env
Environment=SK_CONFIG=/etc/search-kestrel/config.toml
StateDirectory=search-kestrel
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
SuccessExitStatus=10 3
TimeoutStartSec=12h
