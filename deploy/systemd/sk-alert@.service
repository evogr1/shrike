[Unit]
Description=Search Kestrel crash alert for %i

[Service]
Type=oneshot
ExecStart=/opt/search-kestrel/venv/bin/sk-jobs alert --unit %i
User=sk
Group=sk
EnvironmentFile=/etc/search-kestrel/env
Environment=SK_ENV_FILE=/etc/search-kestrel/env
Environment=SK_CONFIG=/etc/search-kestrel/config.toml
StateDirectory=search-kestrel
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
TimeoutStartSec=10min
