[Unit]
Description=Shrike setup check
After=network-online.target
Wants=network-online.target


[Service]
Type=oneshot
ExecStart=/opt/shrike/venv/bin/shrike setup
User=shrike
Group=shrike
EnvironmentFile=/etc/shrike/env
Environment=SHRIKE_ENV_FILE=/etc/shrike/env
Environment=SHRIKE_CONFIG=/etc/shrike/config.toml
StateDirectory=shrike
StateDirectoryMode=0750
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
TimeoutStartSec=2h
