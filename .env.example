# Copy to /etc/search-kestrel/env (owner root:root, mode 600). Never commit real values.
SK_SERVICE_ACCOUNT_FILE=/etc/search-kestrel/sa.json
SK_TRELLO_KEY=
SK_TRELLO_TOKEN=
# Phase 1 only:
# SK_API_KEY=            # at least 24 characters
# SK_MCP_SECRET=         # optional; at least 24 characters when set
# SK_URL=http://127.0.0.1:8899
SK_CONFIG=/etc/search-kestrel/config.toml
