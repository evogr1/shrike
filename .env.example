# Copy to /etc/shrike/env (owner root:root, mode 600). Never commit real values.
SHRIKE_SERVICE_ACCOUNT_FILE=/etc/shrike/sa.json
SHRIKE_TRELLO_KEY=
SHRIKE_TRELLO_TOKEN=
# Phase 1 only:
# SHRIKE_API_KEY=            # at least 24 characters
# SHRIKE_MCP_SECRET=         # optional; at least 24 characters when set
# SHRIKE_URL=http://127.0.0.1:8899
SHRIKE_CONFIG=/etc/shrike/config.toml
